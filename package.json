{
  "name": "frontend-project-386",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "oxlint --type-aware --type-check",
    "test": "vitest --project unit",
    "test:run": "vitest run --project unit",
    "check": "node scripts/check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration": "vitest --config vitest.integration.config.mts",
    "test:integration:run": "vitest run --config vitest.integration.config.mts",
    "test:coverage:run": "vitest run --coverage",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@orpc/client": "1.16.3",
    "@orpc/contract": "1.16.3",
    "@orpc/server": "1.16.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@vercel/schedules": "0.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "postcss": "^8.5.33",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "0.31.11",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "eslint-plugin-sonarjs": {
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "ts-api-utils": {
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
  },
  "allowScripts": {
    "lefthook@2.2.2": true
  }
}
