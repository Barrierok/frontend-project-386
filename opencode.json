{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "mcp": {
    "servers": {
      "shadcn": {
        "type": "local",
        "command": ["npx", "shadcn@latest", "mcp"]
      },
      "next-devtools": {
        "type": "local",
        "command": ["npx", "-y", "next-devtools-mcp@latest"],
        "environment": {}
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      }
    }
  }
}
