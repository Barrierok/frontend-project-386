{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "sortImports": {
    "internalPattern": ["@/"]
  },
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css",
    "functions": ["cn", "cva"]
  },
  "sortPackageJson": true,
  "ignorePatterns": [
    ".agents/**",
    ".next/**",
    "coverage/**",
    "CHANGELOG.md",
    "package-lock.json",
    ".github/workflows/hexlet-check.yml"
  ]
}
