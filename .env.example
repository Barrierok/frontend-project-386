# Скопируйте в .env.local и подставьте значения из Supabase Dashboard → Connect.
# .env.local не коммитится (см. .gitignore). В Vercel те же переменные задаются в Project Settings → Environment Variables.

# Рантайм-подключение через shared pooler Supabase, transaction mode (порт 6543).
# Используется приложением в локальной разработке и на Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:6543/postgres?sslmode=require

# Подключение для миграций drizzle-kit (порт 5432).
# Shared pooler в session mode (IPv4) или прямое подключение db.<project-ref>.supabase.co,
# если сеть поддерживает IPv6. Через порт 6543 миграции не запускать.
DIRECT_URL=postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres?sslmode=require
